      // ==========================================
      // ADMIN AUTHENTICATION
      // ==========================================
      async verifyAdmin(email, passwordPlain, env = {}) {
        const cleanEmail = email.toLowerCase().trim();
        const primary = this.connections.find((c) => c.sql && c.status === "connected");
        if (primary && primary.sql) {
          try {
            const rows = await primary.sql`SELECT * FROM admin_users WHERE LOWER(email) = ${cleanEmail} LIMIT 1`;
            if (rows.length > 0) {
              const user = rows[0];
              const isValid = await bcryptjs_default.compare(passwordPlain, user.password_hash);
              if (isValid) {
                return {
                  id: user.id,
                  email: user.email,
                  name: user.name,
                  role: user.role || "superadmin",
                  createdAt: user.created_at ? new Date(user.created_at).toISOString() : (/* @__PURE__ */ new Date()).toISOString()
                };
              }
              return null;
            }
          } catch (err) {
            console.error("[MultiDbManager] Error querying admin user from database:", err);
          }
        }
        const adminEmail = (env.ADMIN_EMAIL || "")?.trim().toLowerCase();
        const adminPassword = (env.ADMIN_PASSWORD || "")?.trim();
        if (adminEmail && adminPassword && cleanEmail === adminEmail) {
          if (passwordPlain === adminPassword) {
            const adminObj = {
              id: "admin-master",
              email: adminEmail,
              name: "SKx Movies Chief Admin",
              role: "superadmin",
              createdAt: (/* @__PURE__ */ new Date()).toISOString()
            };
            if (primary && primary.sql) {
              try {
                const hash2 = await bcryptjs_default.hash(passwordPlain, 10);
                await primary.sql`
              INSERT INTO admin_users (id, email, password_hash, name, role, created_at)
              VALUES (${adminObj.id}, ${adminObj.email}, ${hash2}, ${adminObj.name}, ${adminObj.role}, NOW())
              ON CONFLICT (email) DO NOTHING
            `;
              } catch {
              }
            }
            return adminObj;
          }
        }
        return null;
      }
      async changeAdminPassword(userId, newPasswordPlain) {
        const hash2 = await bcryptjs_default.hash(newPasswordPlain, 10);
        const primary = this.connections.find((c) => c.sql && c.status === "connected");
        if (primary && primary.sql) {
          try {
            await primary.sql`UPDATE admin_users SET password_hash = ${hash2} WHERE id = ${userId}`;
            return true;
          } catch (e) {
            console.error("[MultiDbManager] changeAdminPassword error:", e);
            throw e;
          }
        }
        return true;
      }
