# CockroachDB / PostgreSQL Connection Strings (Multi-Database Support)
# Primary Database (Used for read and write by default)
DATABASE_URL="postgresql://user:password@cockroach-cluster-host:26257/skxmovies?sslmode=verify-full"

# Secondary & Tertiary Databases (Added when primary database reaches capacity)
# When configured, old data remains readable from primary, and new data writes automatically to the latest active database.
