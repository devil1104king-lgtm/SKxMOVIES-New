# Cloudflare Pages / Edge Environment Configuration
# CockroachDB / PostgreSQL Connection Strings (Multi-Database Support)
# Primary Database (or use Cloudflare Hyperdrive binding HYPERDRIVE)
DATABASE_URL="postgresql://user:password@cockroach-cluster-host:26257/skxmovies?sslmode=verify-full"

# Secondary & Additional Databases (Optional - Multi-DB scaling)
# Old data remains readable from earlier databases; new entries write to the latest active database.
# DATABASE_URL_2="postgresql://user:password@cockroach-cluster-2-host:26257/skxmovies?sslmode=verify-full"
# DATABASE_URL_3=""

# Admin Authentication & Security
JWT_SECRET="your-secure-jwt-secret-key-at-least-32-characters"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your-strong-admin-password"

# Optional Cloudflare / Environment flags
NODE_ENV="production"
